{
  "name": "splitfinance-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright end-to-end tests driving the real SplitFinance UI in a browser",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "screenshots": "cross-env CAPTURE_SCREENSHOTS=1 playwright test screenshots --workers=1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "cross-env": "^10.1.0"
  }
}
