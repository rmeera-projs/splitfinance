node_modules/
docker-compose.override.yml

# Playwright run artefacts - traces/screenshots/video from failures, and
# the generated HTML report. The screenshots the README embeds are NOT
# these; those are committed under docs/screenshots/.
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
e2e/.cache/
.env
.env.local
dist/
build/
*.log
.DS_Store

# Claude Code - personal permission overrides, not meant to be shared/committed.
.claude/settings.local.json
# Project guidance for Claude Code - kept local rather than public. Claude
# Code still reads it from the working directory; it just no longer ships
# with the repo.
CLAUDE.md

# Terraform - state and generated secrets never belong in git.
# terraform.lock.hcl (provider version lockfile) is intentionally NOT
# ignored - that one should be committed, like package-lock.json.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
terraform/*.pem
terraform/tfplan
