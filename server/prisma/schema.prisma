generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  name            String
  username        String    @unique
  email           String    @unique
  passwordHash    String    @map("password_hash")
  // Embedded in every issued JWT and checked on every authenticated
  // request (see middleware/auth.js) - bumped whenever the password
  // changes or is reset, so a stolen token stops working immediately
  // instead of staying valid for the rest of its 7-day life.
  tokenVersion    Int       @default(0) @map("token_version")
  // Gates access to the admin dashboard (server/src/controllers/
  // adminController.js) - platform-wide stats, not scoped to any group.
  // No self-service way to become an admin; set directly in the database.
  isAdmin         Boolean   @default(false) @map("is_admin")
  /// Null until the address is confirmed by clicking an emailed link. Only
  /// gates the Cohere-backed features (see middleware/requireVerifiedEmail
  /// .js) - an unverified account can still use the whole expense-splitting
  /// app, because the abuse this exists to stop is throwaway signups
  /// burning metered AI quota, not people using the product.
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  groupsOwned             Group[]                  @relation("GroupOwner")
  memberships             GroupMember[]
  expensesPaid            Expense[]                @relation("ExpensePayer")
  splits                  ExpenseSplit[]
  settlementsFrom         Settlement[]             @relation("SettlementFrom")
  settlementsTo           Settlement[]             @relation("SettlementTo")
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@map("users")
}

// The raw token is emailed to the user and never stored - only its SHA-256
// hash lives here, same reasoning as hashing passwords: a database leak
// alone shouldn't hand out usable reset links.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// Same shape and same reasoning as PasswordResetToken above: the raw token
// goes out by email and only its SHA-256 hash is stored, so a database leak
// alone cannot be used to mark addresses verified.
model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model Group {
  id          Int      @id @default(autoincrement())
  name        String
  createdBy   Int      @map("created_by")
  isFinalized Boolean  @default(false) @map("is_finalized")
  createdAt   DateTime @default(now()) @map("created_at")

  owner       User          @relation("GroupOwner", fields: [createdBy], references: [id])
  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]

  @@map("groups")
}

model GroupMember {
  groupId  Int      @map("group_id")
  userId   Int      @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@map("group_members")
}

model Expense {
  id          Int      @id @default(autoincrement())
  groupId     Int      @map("group_id")
  paidBy      Int      @map("paid_by")
  /// Integer cents, not dollars - $10.23 is stored as 1023. See
  /// src/utils/money.js for why money never touches a float here.
  amount      Int
  description String
  category    String   @default("Other")
  date        DateTime @default(now())
  createdAt   DateTime @default(now()) @map("created_at")

  group  Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer  User           @relation("ExpensePayer", fields: [paidBy], references: [id])
  splits ExpenseSplit[]

  @@map("expenses")
}

model ExpenseSplit {
  id         Int @id @default(autoincrement())
  expenseId  Int @map("expense_id")
  userId     Int @map("user_id")
  /// Integer cents - see Expense.amount.
  amountOwed Int @map("amount_owed")

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@map("expense_splits")
}

model Settlement {
  id        Int      @id @default(autoincrement())
  groupId   Int      @map("group_id")
  fromUser  Int      @map("from_user")
  toUser    Int      @map("to_user")
  /// Integer cents - see Expense.amount.
  amount    Int
  date      DateTime @default(now())
  createdAt DateTime @default(now()) @map("created_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  from  User  @relation("SettlementFrom", fields: [fromUser], references: [id])
  to    User  @relation("SettlementTo", fields: [toUser], references: [id])

  @@map("settlements")
}
