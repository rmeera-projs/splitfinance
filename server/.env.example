DATABASE_URL="postgresql://postgres:postgres@localhost:5432/splitfinance?schema=public"
JWT_SECRET="change-this-to-a-long-random-string"
PORT=5000
CLIENT_URL="http://localhost:5173"

# Used by categorizationService to auto-categorize expenses via Cohere's Chat
# endpoint. If unset, expenses are simply categorized as "Other".
COHERE_API_KEY=""

# Used by emailService to send password reset links via Resend
# (https://resend.com - free tier, no domain verification needed to start).
# If unset, forgot-password still "succeeds" (no user-enumeration leak) but
# the email is skipped - the reset link is logged to the console instead,
# which is enough for local development.
RESEND_API_KEY=""
